# Every environment variable the API reads. Copy to .env to override locally.

# development | test | production
APP_ENV=development

# debug | info | warning | error
LOG_LEVEL=info
# text: readable, for a terminal | json: one object per line, for the cluster
LOG_FORMAT=text

# Comma-separated browser origins allowed to call the API. Never * in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Largest PDF accepted, in bytes (20 MiB). Request bodies get 1 MiB more for multipart framing.
MAX_UPLOAD_BYTES=20971520
# Most pages a PDF may have.
MAX_PDF_PAGES=200

# Chunking, in characters. Each page is split on its own so every chunk keeps its page number.
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Answers (Anthropic). The model is claude-haiku-5-5.
ANTHROPIC_API_KEY=
LLM_MAX_OUTPUT_TOKENS=1024

# Embeddings (Voyage AI). The dimension must match the vector index.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_DIMENSIONS=1024

# Pinecone: a classic vector index, 1024 dimensions, cosine, serverless aws us-east-1.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=docchat

# Where uploaded PDFs are kept when stored on the local filesystem.
FS_STORAGE_DIR=var/storage
