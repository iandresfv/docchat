# Every environment variable the API reads. Copy to .env to override locally.

# development | test | production
APP_ENV=development

# debug | info | warning | error
LOG_LEVEL=info
# text: readable, for a terminal | json: one object per line, for the cluster
LOG_FORMAT=text

# Comma-separated browser origins allowed to call the API. Never * in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Largest PDF accepted, in bytes (20 MiB). Request bodies get 1 MiB more for multipart framing.
MAX_UPLOAD_BYTES=20971520
