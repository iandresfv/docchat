# Base URL of the API. Empty = same origin (Vite proxies /api in dev, nginx in the image).
VITE_API_URL=
# Product name shown in the UI.
VITE_APP_NAME=DocChat
# Dev server only: where Vite proxies /api.
VITE_DEV_API_TARGET=http://localhost:8000
# "true" serves a fake API from MSW in the browser (no backend needed).
VITE_API_MOCKS=false
